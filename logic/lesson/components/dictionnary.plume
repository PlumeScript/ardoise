let html = $import(html)

// Make a big list of definitions readable
// Options saved inside _ entry:
// - gap (space between lignes, multiples of var(--space-1x))
// - nameSize (%)
Dictionnary: macro(...entries)
	let options = $ entries._? or Table()
	let style = do
		let columns = $ options.columns? or 1
		if options.nameSize?
			gridTemplateColumns: repeat($columns, $options.nameSize% 1fr)
		else
			gridTemplateColumns: repeat($columns, max-content 1fr)
		end
		if options.rowGap?
			rowGap: calc($options.rowGap * var(--space-1x))
		end
		if options.columnGap?
			columnGap: calc($options.columnGap * var(--space-1x))
		end
	end

	@html.Div(class: ardoise--dictionnary pages--to-flow, style: $style)
		for k, v in items(entries)
			if k != "_"
				@html.Div(class: ardoise--dictionnary--name)
					style: do
						
					end
					- $html.Span($k, class: ardoise--dictionnary--name--body)
				end
				@html.Div(class: ardoise--dictionnary--body pages--to-flow)
					$v
				end
			end
		end
	end
end