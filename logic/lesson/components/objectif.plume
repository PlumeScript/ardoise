let html = $import(html)
let Frame from $import(../../core/components/frame)

Objectif: macro(count, content, title:)
	@Frame
		title: do
			@html.Span(class: ardoise--frame--title--prefix)
				Objectif $html.Span($count, class: ardoise--objectif-count)
			end
			if title
				\s$title
			end
		end
		- $content
	end
end