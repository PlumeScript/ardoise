let pages = $import(pages)
let html  = $import(html)
let Frame from $import(../core/components/frame)
let applyFormatNumbering from $import(pages)

macro makeExTitle(exercice, exerciceCount, marker)
	@html.Div(class: ardoise--exercice-sheet--exercice--title)
		@html.Div(class: ardoise--exercice-sheet--exercice--title--obj)
			Obj $html.Span($exercice.objective, class: ardoise--objectif-count)
		end
		@html.Div(class: ardoise--exercice-sheet--exercice--title--no)
			$ applyFormatNumbering(1, marker, Table(exerciceCount))
		end
		if exercice.level?
			@html.Div(class: ardoise--level)
				for in in seq(exercice.level)
					$html.Span(,class: ardoise--level--full)
				end
				for in in seq((exercice.maxLevel? or 3) - exercice.level)
					$html.Span(,class: ardoise--level--empty)
				end
			end
		end
	end
end

macro InstructionRender(exercice, exerciceCount, marker, seed)
	@html.Div(class: pages--to-flow ardoise--exercice-sheet--exercice ardoise--exercice-sheet--exercice-level-$(exercice.level? or 2))
		@Frame(title: $makeExTitle($exercice, $exerciceCount, $marker))
			$ exercice.generator.get(exerciceCount, seed: seed).render("instruction")
		end
	end
end

macro SolutionRender(exercice, exerciceCount, marker, seed)
	@html.Div(class: pages--to-flow ardoise--exercice-sheet--exercice ardoise--exercice-sheet--exercice-level-$(exercice.level? or 2) pages--to-flow ardoise--exercice-sheet--exercice-solution)
		@Frame(title: $makeExTitle($exercice, $exerciceCount, $marker))
			$ exercice.generator.get(exerciceCount, seed: seed).render("solution")
		end
	end
end

macro SheetRender(rows, columns, callback, cellid:0, ?correction, ?todo)
	@html.Div(class: pages--to-flow ardoise--exercice-sheet $(correction and "ardoise--exercice-sheet-correction"))
		style: do
			gridTemplateColumns: repeat($columns, 1fr)
			gridTemplateRows: repeat($rows, 1fr)
		end
		- do
			for row in seq(rows)
				for column in seq(columns)
					$ callback(cellid)
					if not todo
						set cellid += 1
					end
				end
			end
		end
	end
end


ExerciceSheet: macro(seed:0, pageCount:, exerciceCount:, marker: Ex %1, ?todo, ...exercices)
	let cellid = 1
	@Table.join(sep: $pages.newpage)
		for exercice in exercices
			let exerciceTarget = $(exercice.count? or exerciceCount or 20)
			let _pageCount = $ pageCount or (exerciceTarget/exercice.rows/exercice.columns).ceil()
			let _marker    = $ exercice.marker? or marker
			for i in seq(_pageCount)
				- @SheetRender($exercice.rows, $exercice.columns, cellid: $cellid, todo: $todo)
					macro(exerciceCount)
						$ InstructionRender(exercice, exerciceCount, _marker, seed)
					end
				end
				if not todo
					- @SheetRender($exercice.rows, $exercice.columns, cellid: $cellid, ?correction)
						macro(exerciceCount)
							$ SolutionRender(exercice, exerciceCount, _marker, seed)
						end
					end
					set cellid += $(exercice.rows*exercice.columns)
				end
			end
			if todo
				set cellid += 1
			end
		end
	end
end

ref Exercice: macro(level:, Number rows: 2, Number columns: 2, generator:, objective:, instruction:, marker:)
	level: $level
	rows: $rows
	columns: $columns
	generator: $generator
	objective: $objective
	marker: $marker
end

ExerciceList: macro(...args)
	@Exercice
		...args
	end
end