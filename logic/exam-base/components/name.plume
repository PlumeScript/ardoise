let html = $import(html)
let Frame from $import(../../core/components/frame)

macro makeTotalMark(n)
	@html.Div(class: ardoise--exam--total-mark)
		@html.Span(class: ardoise--exam--total-mark--value)
			$n
		end
	end
end

ExamName: macro(mark:)
	@html.Div(class: ardoise--exam--header)
		@html.Div(class: ardoise--exam--name)
			@Frame
				Nom\: .........................................................
			end
			@Frame
				Prénom: ....................................................
			end
			if mark
				@Frame $makeTotalMark($mark)
			end
		end
	end
end