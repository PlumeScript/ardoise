let pages  = $import(pages)
let html   = $import(html)
let global = $import(../../../global)
let chapterTitle from $import(../../core/components/chapterTitle)

Exam: macro(varcount, generator)
	@Table.join(sep: $pages.newpage)
		for i in seq(varcount)
			set global.examIteration = $i
			- $ generator(global.examIteration)
		end
	end
end