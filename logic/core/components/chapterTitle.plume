let html    = $import(html)
let context = $import(../../../context)
let applyFormatNumbering from $import(pages)
let loadImg from $import(../utils/img)

chapterTitle: macro(num, title, illustration:)
	let marker = $context.chapterTitleMark()
	@html.H1(class: ardoise--frame ardoise--chapter-title)
		@html.Span(class: ardoise--chapter-title--num)
			if num > 0
				$ applyFormatNumbering(1, marker, Table(num))
			else
				0
			end
		end
		@html.Span(class: ardoise--chapter-title--body)
			$title
		end
		if illustration
			$ loadImg(illustration, "top-bottom")
		end
	end
end