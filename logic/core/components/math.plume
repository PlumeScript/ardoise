let pages = $import(pages)

m: macro (content)
	$pages.formula($content, processor: ascii)
end

M: macro (content)
	$pages.formula($content, processor: ascii, ?display)
end

Mm: macro (content)
	$pages.formula($content, processor: ascii, ?inlineDisplay)
end

mx: macro (content)
	$pages.formula($content)
end

Mx: macro (content)
	$pages.formula($content, ?display)
end

Mmx: macro (content)
	$pages.formula($content, ?inlineDisplay)
end