let html = $import(html)
let Frame from $import(./frame-base)

macro makeTitle(base, name)
	$html.Span($base, class: ardoise--frame--title--prefix)
	if name
		\s$html.Span($name, class: ardoise--frame--title--name)
	end
end

ref Definition: macro(content, name:)
	let title = @makeTitle
		- if plume.locale() == "fr"
			Définition
		else
			Definition
		end
		- $name
	end

	@Frame(title: $title)
		$content
	end
end
Def: $Definition
ref Definitions: macro(content, name:)
