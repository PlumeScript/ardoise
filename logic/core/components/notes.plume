let html = $import(html)

note: macro(content)
	@html.Span(class: ardoise--note)
		$content
	end
end

hint: macro(content)
	@html.Span(class: ardoise--hint)
		$content
	end
end

quote: macro(content)
	@html.Span(class: ardoise--quote $(plume.locale() == "fr" and "ardoise--quote-french"))
		$content
	end
end