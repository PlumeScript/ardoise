let html = $import(html)

ref vocabulary: macro(content)
	@html.Span(class: ardoise--vocabulary)
		$content
	end
end

voc: $vocabulary

important: macro(content)
	@html.Span(class: ardoise--important)
		$content
	end
end

secondary: macro(content)
	@html.Span(class: ardoise--secondary)
		$content
	end
end