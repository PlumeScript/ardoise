let pages   = $import(pages)
let html    = $import(html)
let config  = $import(./config)
let utils   = $import(./utils)
let context = $import(./context)

let param arg1  = lesson
let param theme = core

// Resolve logic and style
let lib = $config.load($arg1, $theme)

// Load libs
let baseDocument = $ pages.Document
ardoiseContext: $context
...pages
for i in seq(1, len(lib.names))
	let name = $lib.names[len(lib.names)-i+1]
	set baseDocument = $ baseDocument or lib.logic[name].Document?
	...lib.logic[name]
end

// Overwrite Document to inject CSS
Document: macro(content, ...args)
	@baseDocument(...args)
		@html.Style
			for i in seq(1, len(lib.names))
				let name = $lib.names[len(lib.names)-i+1]
				$lib.theme[name]
			end
		end
		@html.Script
			document.addEventListener('DOMContentLoaded', async function () {
				await window.__pagesReady;
				for i in seq(1, len(lib.names))
					let name = $lib.names[len(lib.names)-i+1]
					$lib.script[name]
				end
			})
		end
		$content
	end
end