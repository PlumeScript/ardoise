use pages

let version = v0.1.0

@Document(filename: doc/doc, pagination: 3)
	$vfill
	@MainTitle
		title: $image($os.Path(./logo.svg)) Documentation
		subtitle: $version
	end

	$vfill
	$newpage

	@Header(?excludeFirst)
	  left: Ardoise Documentation
	end
	
	@Footer(?excludeFirst)
	  center: $version
	end

	$whitePage
	$tableOfContents(title: Table of contents)
	$newpage
end