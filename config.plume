let utils = $import(./utils)

style: $empty

ref paths: do
	templates: $os.Path(./logic)
	themes:    $os.Path(./static/css)
	scripts:   $os.Path(./static/js)
end

macro getTemplateDir(name)
	if not name
		raise do
			You must provide a template name (ex: `use ardoise(lesson)`)\n
			$utils.getSupported(template, $paths.templates)
		end
	end

	let result = $(paths.templates / name)
	if not result.exists()
		raise do
			Unknown template "$name".\n
			$utils.getSupported(template, $paths.templates)
		end
	end
	return $result
end

macro getThemeDir(name)
	let result = $(paths.themes / name)
	if not result.exists()
		raise do
			Unknown theme "$name".\n
			$utils.getSupported(theme, $paths.themes)
		end
	end
	return $result
end


macro getScriptDir(name)
	let result = $(paths.scripts / name)
	if not result.exists()
		raise do
			Unknown script "$name".\n
			$utils.getSupported(style, $paths.scripts)
		end
	end
	return $result
end

macro getStyle(path)
	let core = $(path / "core.css")
	if core.exists()
		$core.read()
	end

	for component in (path / "components").walk()
		if component.getExtension() == "css"
			$component.read()
		end
	end
end

macro getScript(path)
	for component in (path / "components").walk()
		if component.getExtension() == "js"
			$component.read()
		end
	end
end

load: macro(template, theme)
	let result = do
		logic:  $ Table()
		theme:  $ Table()
		script: $ Table()
		names:  $ Table(template)
	end
	let index  = 1
	let loadedCore = $false

	while index <= len(result.names)
		let name = $result.names[index]

		let files = do
			...getTemplateDir($name).walk()
			- $(paths.themes / theme / "core" / "core.plume")
			if theme != "core"
				- $(paths.themes / theme / name / "core.plume")
			end
		end

		set result.logic[name] = for file in files
			if file.getExtension() == "plume"
				...file.import()
			end
		end

		set result.theme[name]  = do
			$ getStyle(getThemeDir("core") / name)
			// Should have inhéritance like templates
			if theme != "core"
				$ getStyle(getThemeDir(theme) / name)
			end
		end
		set result.script[name] = $ getScript(getScriptDir(name))

		for req in result.logic[name].required? or Table()
			run $ Table.append(result.names, req)
		end

		set index += 1

		if index > len(result.names) and not result.logic.core?
			run $ Table.append(result.names, "core")
		end
	end

	return $result
end